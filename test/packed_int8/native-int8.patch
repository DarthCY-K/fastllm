+                        (size_t)weight.dims[0] == rows && (size_t)weight.dims[1] == cols &&
+                        scale.bytes == rows * groups * 2,
+                        "Native packed INT8 destination/scale shape mismatch: " + name);
+        std::vector<uint16_t> scales(rows * groups);
+        scale.ReadRawData(scales.data(), scale.bytes);
+        std::vector<uint8_t> row(cols);
+        auto closeFile = [](FILE *file) { fclose(file); };
+        std::unique_ptr<FILE, decltype(closeFile)> file(fopen(item.fileName.c_str(), "rb"), closeFile);
+        AssertInFastLLM(file != nullptr, "Cannot open packed INT8 weight: " + name);
