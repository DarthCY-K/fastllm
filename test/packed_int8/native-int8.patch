+    static bool TryGetPackedInt8Group128(const SafeTensors &safeTensors,
+                                         const std::string &name) {
+        auto it = safeTensors.itmeDict.find(name);
+        if (it == safeTensors.itmeDict.end() || it->second.dtype != "I32" ||
+            !StringEndWith(name, ".weight_packed") || it->second.shape.size() != 2 ||
+            !PackedShapeMatches(safeTensors, name, 4)) return false;
+        const std::string prefix = name.substr(0, name.size() - strlen(".weight_packed"));
+        if (safeTensors.itmeDict.count(prefix + ".weight_zero_point") ||
+            safeTensors.itmeDict.count(prefix + ".weight_g_idx")) return false;
+        auto scaleIt = safeTensors.itmeDict.find(prefix + ".weight_scale");
+        if (scaleIt == safeTensors.itmeDict.end()) return false;
+        const auto &w = it->second;
+        const auto &s = scaleIt->second;
+        return w.shape[0] > 0 && w.shape[1] > 0 && w.shape[1] % 32 == 0 &&
+            w.shape[0] <= UINT64_MAX / w.shape[1] / 4 &&
+            w.bytes == w.shape[0] * w.shape[1] * 4 &&
+            s.dtype == "BF16" && s.shape.size() == 2 &&
+            s.shape[0] == w.shape[0] && s.shape[1] == w.shape[1] / 32 &&
+            s.len == w.shape[0] * (w.shape[1] / 32);
+    }
