+        const auto &item = safeTensors.itmeDict.at(name);
+        const std::string prefix = name.substr(0, name.size() - strlen(".weight_packed"));
+        const auto &scale = safeTensors.itmeDict.at(prefix + ".weight_scale");
+        const size_t rows = item.shape[0], cols = item.shape[1] * 4, groups = cols / 128;
+        AssertInFastLLM(weight.dataType == DataType::PACKED_INT8_GROUP128_BF16 &&
