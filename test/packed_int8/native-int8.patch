+    // I32 storage alone does not identify bit width: compressed-tensors packs
+    // four INT8 or eight INT4 values per word. Consult the small shape payload
+    // before inferring a group size. Never read/dequantize the weight here.
+    static bool PackedShapeMatches(const SafeTensors &safeTensors,
+                                    const std::string &name, uint64_t packFactor) {
+        const auto &weight = safeTensors.itmeDict.at(name);
+        const std::string prefix = name.substr(0, name.size() - strlen(".weight_packed"));
+        const auto shapeIt = safeTensors.itmeDict.find(prefix + ".weight_shape");
+        if (shapeIt == safeTensors.itmeDict.end()) {
+            return packFactor == 8; // Preserve legacy shape-less INT4 checkpoints.
+        }
+        const auto &shape = shapeIt->second;
+        if (weight.shape.empty() || shape.dtype != "I64" || shape.shape.size() != 1 ||
+            shape.shape[0] != weight.shape.size() ||
+            shape.bytes != weight.shape.size() * sizeof(int64_t)) {
+            return false;
+        }
+        std::vector<int64_t> logical(weight.shape.size());
+        shape.ReadRawData(logical.data(), shape.bytes);
+        for (size_t i = 0; i < logical.size(); i++) {
+            uint64_t factor = i + 1 == logical.size() ? packFactor : 1;
+            if (logical[i] <= 0 || weight.shape[i] > (uint64_t)INT64_MAX / factor ||
+                (uint64_t)logical[i] != weight.shape[i] * factor) {
+                return false; // Padded/ambiguous input dimensions unsupported.
+            }
+        }
+        return true;
+    }
